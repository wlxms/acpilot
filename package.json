{
  "name": "acpilot",
  "displayName": "ACPilot",
  "version": "0.5.0",
  "description": "ACP coding assistant powered by ACP backends",
  "publisher": "wlxms",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlxms/acpilot.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatSessionsProvider"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "opencode-logo": {
        "description": "OpenCode brand logomark",
        "default": {
          "fontPath": "./resources/font-icons/opencode-icon.woff",
          "fontCharacter": "\\E001"
        }
      },
      "acpilot-a": {
        "description": "ACPilot status bar icon (Agent Client Protocol logomark)",
        "default": {
          "fontPath": "./resources/font-icons/opencode-icon.woff",
          "fontCharacter": "\\E002"
        }
      }
    },
    "commands": [
      {
        "command": "acpilot.openSettings",
        "title": "ACP: Open Settings",
        "category": "ACP"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "opencode",
        "displayName": "OpenCode",
        "managementCommand": "acpilot.openSettings"
      },
      {
        "vendor": "acp",
        "displayName": "ACP Agent",
        "managementCommand": "acpilot.openSettings"
      },
      {
        "vendor": "reasonix",
        "displayName": "Reasonix",
        "managementCommand": "acpilot.openSettings"
      }
    ],
    "configuration": {
      "title": "ACPilot",
      "properties": {
        "acpilot.experimental.streamSchedulingMode": {
          "type": "string",
          "default": "tool-first",
          "enum": [
            "immediate",
            "continuous",
            "tool-first"
          ],
          "enumDescriptions": [
            "Disable scheduling and render stream parts as they arrive.",
            "Keep root reasoning, markdown, and root tools continuous; render subagent tools at main-flow boundaries.",
            "Render tools immediately and buffer root reasoning or markdown until their part is complete."
          ],
          "description": "Controls how ACP stream parts are scheduled before rendering to VS Code chat."
        },
        "acpilot.backends.reasonix.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the built-in Reasonix ACP backend target. It starts lazily when the Reasonix chat target is used."
        },
        "acpilot.backends.reasonix.command": {
          "type": "string",
          "default": "npx",
          "description": "Command used to spawn the Reasonix ACP agent."
        },
        "acpilot.backends.reasonix.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-y",
            "reasonix",
            "acp"
          ],
          "description": "Arguments passed to the Reasonix ACP agent command."
        }
      }
    },
    "chatSessions": [
      {
        "type": "acpilot.opencode",
        "name": "opencode",
        "displayName": "OpenCode",
        "description": "AI coding agent powered by OpenCode",
        "icon": "$(opencode-logo)",
        "inputPlaceholder": "Ask OpenCode anything...",
        "canDelegate": true,
        "requiresCustomModels": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsToolAttachments": true,
          "supportsImageAttachments": true
        },
        "commands": [
          {
            "name": "new",
            "description": "Start a new conversation session"
          },
          {
            "name": "help",
            "description": "Show available commands"
          },
          {
            "name": "model",
            "description": "Show or change the current model"
          },
          {
            "name": "test-external-edit",
            "description": "Test externalEdit bubble push"
          },
          {
            "name": "test-external-edit-real",
            "description": "Test externalEdit with direct disk write (simulates server)"
          },
          {
            "name": "test-external-edit-e2e",
            "description": "End-to-end test via real OpenCode prompt"
          },
          {
            "name": "test-subagent-single-blocking",
            "description": "Diagnostic: single subagent, blocking (pending→running→completed)"
          },
          {
            "name": "test-subagent-multi-blocking",
            "description": "Diagnostic: multiple subagents, sequential blocking"
          },
          {
            "name": "test-subagent-single-parallel",
            "description": "Diagnostic: single subagent, parallel/callback pattern"
          },
          {
            "name": "test-subagent-multi-parallel",
            "description": "Diagnostic: multi subagents, all parallel"
          },
          {
            "name": "test-file-read-stream",
            "description": "Run file-bubble lifecycle experiment matrix"
          },
          {
            "name": "test-stream-latency",
            "description": "Diagnostic: measure streaming event latency from backend (delta timing + batch detection)"
          },
          {
            "name": "test-thinking",
            "description": "Diagnostic: verify thinkingProgress API and reasoning/text boundary rendering"
          },
          {
            "name": "test-question",
            "description": "Diagnostic: test questionCarousel UI flow (single-select, multi-select, text input)"
          },
          {
            "name": "test-question-full",
            "description": "Test questionCarousel UI flow (single-select, multi-select, text input)"
          }
        ]
      },
      {
        "type": "acpilot.acp",
        "name": "acp",
        "displayName": "ACP Agent",
        "description": "Any standard Agent Client Protocol agent (JSON-RPC 2.0)",
        "icon": "$(acpilot-a)",
        "inputPlaceholder": "Ask the ACP agent...",
        "canDelegate": true,
        "requiresCustomModels": false,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsToolAttachments": true,
          "supportsImageAttachments": true
        },
        "commands": [
          {
            "name": "new",
            "description": "Start a new conversation session"
          },
          {
            "name": "help",
            "description": "Show available commands"
          }
        ]
      },
      {
        "type": "acpilot.reasonix",
        "name": "reasonix",
        "displayName": "Reasonix",
        "description": "AI coding agent powered by Reasonix ACP",
        "icon": "$(acpilot-a)",
        "inputPlaceholder": "Ask Reasonix anything...",
        "canDelegate": true,
        "requiresCustomModels": false,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsToolAttachments": true,
          "supportsImageAttachments": true
        },
        "commands": [
          {
            "name": "new",
            "description": "Start a new conversation session"
          },
          {
            "name": "help",
            "description": "Show available commands"
          },
          {
            "name": "model",
            "description": "Show or change the current model"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "lint": "tsc --noEmit && eslint src/",
    "lint:eslint": "eslint src/",
    "lint:all": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run test:runtime",
    "test:runtime": "npm run compile && node scripts/runtime-smoke.cjs",
    "generate-font": "node scripts/generate-font.cjs",
    "vscode:prepublish": "npm run generate-font && npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.40",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.24.2",
    "eslint": "^10.4.0",
    "fantasticon": "^4.1.0",
    "glob": "^13.0.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.0.0",
    "@opencode-ai/sdk": "1.18.0",
    "opencode-ai": "1.18.0",
    "ws": "^8.18.3",
    "zod": "^3.25.0"
  }
}
